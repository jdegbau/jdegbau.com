<script>
  // Explorer: collapsed by default on narrow screens, and the link for the
  // section being read is marked as current.
  const explorer = document.querySelector<HTMLDetailsElement>('[data-explorer]');
  if (explorer && window.matchMedia('(max-width: 61.99rem)').matches) explorer.open = false;

  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-explorer-link]')].map((link) => [link.dataset.explorerLink, link]),
  );
  let current: HTMLAnchorElement | undefined;
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const link = links.get(entry.target.id);
        if (!link || link === current) continue;
        current?.removeAttribute('aria-current');
        link.setAttribute('aria-current', 'location');
        current = link;
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  document.querySelectorAll('[data-spec]').forEach((section) => observer.observe(section));
</script>

