---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChartTypeAssessment from '../components/ChartTypeAssessment.astro';
import ChartPickerQuiz from '../components/ChartPickerQuiz.astro';
import DataStoryBestPractices from '../components/DataStoryBestPractices.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import BlogCard from '../components/BlogCard.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Hero from '../components/Hero.astro';
import Image from '../components/Image.astro';
import TableOfContents from '../components/TableOfContents.astro';
import QuickCompareMatrix from '../components/QuickCompareMatrix.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import Logotype from '../components/Logotype.astro';
import Logos from '../components/Logos.astro';
import SummaryCard from '../components/SummaryCard.astro';
import Callout from '../components/Callout.astro';
import CallToAction from '../components/CallToAction.astro';
import Steps from '../components/Steps.astro';
import Tabs from '../components/Tabs.astro';
import TabPanel from '../components/TabPanel.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import AnnotatedFigure from '../components/AnnotatedFigure.astro';
import DownloadCard from '../components/DownloadCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import PostSeriesNav from '../components/PostSeriesNav.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ChartPlayground from '../components/ChartPlayground.astro';
import Section from '../components/Section.astro';
import ChartGlyph from '../components/ChartGlyph.astro';
import PostCover from '../components/PostCover.astro';
import Portrait from '../components/Portrait.astro';
import TrendChart from '../components/TrendChart.astro';
import ChartFrame from '../components/ChartFrame.astro';
import FeatureList from '../components/FeatureList.astro';
import ArticleHeader from '../components/ArticleHeader.astro';
import Sidenote from '../components/Sidenote.astro';
import Testimonial from '../components/Testimonial.astro';
import TestimonialGroup from '../components/TestimonialGroup.astro';
import StatRow from '../components/StatRow.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import { KIND_USES, SCENES, TOPICS } from '../lib/cover-art.mjs';
import Spec from './_components/Spec.astro';
import { getAllPosts } from '../lib/posts';

// Use a real post so the BlogCard example always reflects live data.
const allPosts = await getAllPosts();
const [samplePost] = allPosts;
const coverKinds = Object.entries(KIND_USES) as [string, string][];
// One sample of each cover scene, with made-up details.
const sceneDemos: [string, { scene: string; [key: string]: unknown }][] = [
  ['browser', { scene: 'browser', url: 'example.com/shoes/?utm_source=newsletter', highlight: 'utm_source', note: 'campaign tag' }],
  ['serp', { scene: 'serp', query: 'how long should a blog post be', questions: ['What is the ideal blog post length?', 'Do longer posts rank better?', 'How many words is a 5-minute read?'], highlight: 1 }],
  ['editor', { scene: 'editor', file: 'tracking.js', lines: ["window.dataLayer = window.dataLayer || [];", "dataLayer.push({", "  event: 'generate_lead',", "  form_id: 'contact'", "});"], highlight: 3 }],
  ['timeline', { scene: 'timeline', ticks: ['9:00', '9:30', '10:00', '10:30', '11:00'], marker: '30 min idle', marker_at: 0.5 }],
  ['document', { scene: 'document', title: 'Content brief', headings: ['Audience', 'Search intent', 'Key questions', 'Evidence', 'Next step'], highlight: 2 }],
  ['checklist', { scene: 'checklist', title: 'Launch checklist', items: ['Redirect map approved', 'Canonicals updated', 'Analytics firing on new templates', 'Sitemaps resubmitted'], highlight: 2 }],
  ['chart', { scene: 'chart', kind: 'trend', data: [120, 118, 104, 98, 110, 160, 210, 240] }],
];

const sampleFaqs = [
  {
    question: 'How do I choose the right chart type for my SEO data?',
    answer:
      '<p>Choose a chart based on the relationship you want to highlight: line charts for trends, bar charts for comparisons, and scatter plots for correlations.</p>',
  },
  {
    question: 'What is the 5-second rule?',
    answer:
      '<p>The primary insight should be visible within five seconds of viewing a chart. Strong titles, limited noise, and clear emphasis make that possible.</p>',
  },
  {
    question: 'Why is context critical in SEO reporting?',
    answer:
      '<p>Context helps stakeholders understand whether a number is good or bad by comparing it against benchmarks, seasonal patterns, or YoY change.</p>',
  },
];

// Sample series for the TrendChart demo (illustrative).
const sampleTrend = [42, 44, 41, 43, 40, 42, 41, 47, 52, 55, 61, 64, 70, 73];

const sampleFeatures = [
  { glyph: 'hierarchy' as const, title: 'Content strategy', text: 'Audits, editorial planning, and governance.' },
  { glyph: 'compare' as const, title: 'Data visualization', text: 'Charts built around the question being asked.' },
  { glyph: 'trend' as const, title: 'Measurement strategy', text: 'KPIs, measurement plans, and tracking.' },
  { glyph: 'search' as const, title: 'SEO', text: 'Audits and search-informed planning.' },
];

const sampleTocItems = [
  { id: 'component-blogcard', text: 'BlogCard', level: 2 },
  { id: 'component-hero', text: 'Hero', level: 2 },
  { id: 'component-contactform', text: 'ContactForm', level: 2 },
  { id: 'component-tableofcontents', text: 'TableOfContents', level: 2 },
];

// Sample flows for the ChartPlayground demo: traffic source → landing page → outcome.
const sankeyFlows = [
  { from: 'Search', to: 'Blog', flow: 320 },
  { from: 'Search', to: 'Pricing', flow: 120 },
  { from: 'Search', to: 'Home', flow: 80 },
  { from: 'Social', to: 'Blog', flow: 140 },
  { from: 'Social', to: 'Home', flow: 40 },
  { from: 'Email', to: 'Pricing', flow: 90 },
  { from: 'Email', to: 'Home', flow: 50 },
  { from: 'Direct', to: 'Home', flow: 110 },
  { from: 'Direct', to: 'Pricing', flow: 50 },
  { from: 'Blog', to: 'Signed up', flow: 60 },
  { from: 'Blog', to: 'Left', flow: 400 },
  { from: 'Pricing', to: 'Signed up', flow: 140 },
  { from: 'Pricing', to: 'Left', flow: 120 },
  { from: 'Home', to: 'Signed up', flow: 50 },
  { from: 'Home', to: 'Left', flow: 230 },
];
const tinyFlows = ['Referral', 'Partners', 'Podcast', 'Ads'].flatMap((source) => [
  { from: source, to: 'Blog', flow: 12 },
  { from: source, to: 'Home', flow: 9 },
]);
const sankeyDataset = (flows: typeof sankeyFlows, colors: Record<string, string>) => ({
  label: 'Visitors',
  data: flows,
  color: 'var(--jdb-fg)',
  borderWidth: 0,
  nodeWidth: 12,
  nodePadding: 18,
  ...colors,
});
const calmColors = { colorFrom: 'var(--jdb-navy-600)', colorTo: 'var(--jdb-navy-600)', colorMode: 'from', alpha: 0.45 };
const loudColors = { colorFrom: 'var(--jdb-orange-500)', colorTo: 'var(--jdb-good)', colorMode: 'gradient', alpha: 0.6 };

// Explorer tree, in page order. Every Spec on the page needs an entry here.
const explorer = [
  {
    folder: 'tokens',
    files: [
      { id: 'tokens-color', label: 'color' },
      { id: 'tokens-type', label: 'type' },
      { id: 'tokens-space', label: 'space' },
    ],
  },
  {
    folder: 'brand',
    files: [
      { id: 'component-logotype', label: 'Logotype' },
      { id: 'component-icon', label: 'Icon' },
      { id: 'component-image', label: 'Image' },
      { id: 'component-logos', label: 'Logos' },
      { id: 'component-chartglyph', label: 'ChartGlyph' },
      { id: 'component-postcover', label: 'PostCover' },
      { id: 'component-portrait', label: 'Portrait' },
    ],
  },
  {
    folder: 'page sections',
    files: [
      { id: 'component-section', label: 'Section' },
      { id: 'component-hero', label: 'Hero' },
      { id: 'component-featurelist', label: 'FeatureList' },
      { id: 'component-calltoaction', label: 'CallToAction' },
      { id: 'component-contactform', label: 'ContactForm' },
      { id: 'component-faqaccordion', label: 'FAQAccordion' },
      { id: 'component-blogcard', label: 'BlogCard' },
      { id: 'component-relatedposts', label: 'RelatedPosts' },
      { id: 'component-authorbox', label: 'AuthorBox' },
    ],
  },
  {
    folder: 'proof',
    files: [
      { id: 'component-testimonial', label: 'Testimonial' },
      { id: 'component-testimonialgroup', label: 'TestimonialGroup' },
      { id: 'component-statrow', label: 'StatRow' },
      { id: 'component-casestudycard', label: 'CaseStudyCard' },
      { id: 'component-bookingembed', label: 'BookingEmbed' },
    ],
  },
  {
    folder: 'posts',
    files: [
      { id: 'component-articleheader', label: 'ArticleHeader' },
      { id: 'component-summarycard', label: 'SummaryCard' },
      { id: 'component-sidenote', label: 'Sidenote' },
      { id: 'component-callout', label: 'Callout' },
      { id: 'component-steps', label: 'Steps' },
      { id: 'component-tabs', label: 'Tabs' },
      { id: 'component-beforeafter', label: 'BeforeAfter' },
      { id: 'component-annotatedfigure', label: 'AnnotatedFigure' },
      { id: 'component-downloadcard', label: 'DownloadCard' },
      { id: 'component-videoembed', label: 'VideoEmbed' },
      { id: 'component-tableofcontents', label: 'TableOfContents' },
      { id: 'component-postseriesnav', label: 'PostSeriesNav' },
    ],
  },
  {
    folder: 'data viz',
    files: [
      { id: 'component-chartframe', label: 'ChartFrame' },
      { id: 'component-trendchart', label: 'TrendChart' },
      { id: 'component-chartplayground', label: 'ChartPlayground' },
      { id: 'component-quickcomparematrix', label: 'QuickCompareMatrix' },
      { id: 'component-charttypeassessment', label: 'ChartTypeAssessment' },
      { id: 'component-chartpickerquiz', label: 'ChartPickerQuiz' },
      { id: 'component-datastorybestpractices', label: 'DataStoryBestPractices' },
    ],
  },
];
const componentCount = explorer.slice(1).reduce((total, group) => total + group.files.length, 0);

// Token reference. Ratios are the WCAG values verified in the comments of
// public/assets/css/main.css (section 1); keep them in sync with that file.
const colorGroups = [
  {
    name: 'Surfaces',
    swatches: [
      { token: '--jdb-navy-950', hex: '#0a1526', role: 'Page canvas' },
      { token: '--jdb-navy-900', hex: '#0f1f38', role: 'Header, footer, drawer' },
      { token: '--jdb-navy-800', hex: '#152a49', role: 'Cards and panels (brand navy)' },
      { token: '--jdb-navy-700', hex: '#223a5e', role: 'Raised surface, secondary fill' },
      { token: '--jdb-navy-600', hex: '#33547e', role: 'Logotype brackets, quiet strokes' },
    ],
  },
  {
    name: 'Orange',
    swatches: [
      { token: '--jdb-orange-500', hex: '#ff4d00', role: 'Primary buttons and graphics (brand orange)', ratio: '5.50:1 with navy text on it' },
      { token: '--jdb-orange-400', hex: '#ff7a3d', role: 'Links on cards', ratio: '5.55:1 on cards, 7.06:1 on canvas' },
      { token: '--jdb-orange-600', hex: '#c73d00', role: 'Orange on white (print)', ratio: '5.13:1 on white' },
    ],
  },
  {
    name: 'Text',
    swatches: [
      { token: '--jdb-fg', hex: '#e8ecf4', role: 'Headings and primary text', ratio: '12.15:1 on cards' },
      { token: '--jdb-fg-dim', hex: '#aab4c8', role: 'Body copy', ratio: '6.90:1 on cards' },
      { token: '--jdb-fg-muted', hex: '#8b97b0', role: 'Meta, dates, labels', ratio: '4.90:1 on cards' },
    ],
  },
  {
    name: 'Status',
    note: 'All three pass 7.76:1 or better on canvas and cards.',
    swatches: [
      { token: '--jdb-good', hex: '#4fd68a', role: 'Passing, growth' },
      { token: '--jdb-warn', hex: '#f2b84b', role: 'Needs improvement' },
      { token: '--jdb-bad', hex: '#ff6b6b', role: 'Errors, decline' },
    ],
  },
];

const typeScale = [
  { token: '--jdb-fs-4xl', px: '48–76', role: 'Home hero', display: true },
  { token: '--jdb-fs-3xl', px: '48', role: 'h1', display: true },
  { token: '--jdb-fs-2xl', px: '38', role: 'h2', display: true },
  { token: '--jdb-fs-xl', px: '30', role: 'h3', display: true },
  { token: '--jdb-fs-lg', px: '24', role: 'h4, card titles', display: true },
  { token: '--jdb-fs-md', px: '20', role: 'Lead paragraph', display: false },
  { token: '--jdb-fs-base', px: '17', role: 'Body copy', display: false },
  { token: '--jdb-fs-sm', px: '15', role: 'Nav, labels, small UI', display: false },
  { token: '--jdb-fs-xs', px: '13', role: 'Meta, timestamps, badges', display: false },
];

const spaceScale = [
  { token: '--jdb-s-1', rem: 0.25 }, { token: '--jdb-s-2', rem: 0.5 }, { token: '--jdb-s-3', rem: 0.75 },
  { token: '--jdb-s-4', rem: 1 }, { token: '--jdb-s-5', rem: 1.5 }, { token: '--jdb-s-6', rem: 2 },
  { token: '--jdb-s-7', rem: 2.5 }, { token: '--jdb-s-8', rem: 3 }, { token: '--jdb-s-9', rem: 4 },
  { token: '--jdb-s-10', rem: 5 }, { token: '--jdb-s-11', rem: 6.5 },
];

const sampleMatrixRows = [
  { chartType: 'Line', trends: 'Ideal', compare: 'Capable', composition: 'Poor', distribution: 'Poor', bestFor: 'Traffic over time, ranking trends' },
  { chartType: 'Bar', trends: 'Capable', compare: 'Ideal', composition: 'Poor', distribution: 'Capable', bestFor: 'Channel comparison, page performance' },
  { chartType: 'Donut', trends: 'Poor', compare: 'Capable', composition: 'Ideal', distribution: 'Poor', bestFor: 'Traffic sources, device split' },
];
---
<BaseLayout
  title="Components"
  description="Every shared component on jdegbau.com, rendered live with its props, plus the color, type, and spacing tokens they're built from."
  canonical="/components/"
  noindex={true}
>
  <article class="workspace">
    <header class="workspace__head jdb-container">
      <span class="jdb-eyebrow">src/components</span>
      <h1>Components</h1>
      <p class="workspace__lede">
        Every shared building block on this site, rendered live with its props. Check here before building something new: if one of these fits, reuse it.
      </p>
      <p class="workspace__count">{componentCount} components in {explorer.length - 1} folders, plus the tokens they share.</p>
    </header>

    <div class="workspace__body jdb-container">
      <aside class="explorer-wrap">
        <details class="explorer" open data-explorer>
          <summary class="explorer__title">Explorer</summary>
          <nav aria-label="Components on this page">
            {explorer.map((group) => (
              <div class="explorer__group">
                <p class="explorer__folder">{group.folder}</p>
                <ul>
                  {group.files.map((file) => (
                    <li><a href={`#${file.id}`} data-explorer-link={file.id}>{file.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>
      </aside>

      <div class="workspace__main">
        <section class="tokens" aria-labelledby="tokens-title">
          <header class="tokens__head">
            <h2 id="tokens-title">Tokens</h2>
            <p>Components use these custom properties from <code>public/assets/css/main.css</code>, never raw values. Contrast ratios are WCAG 2.1 and verified, not estimated.</p>
          </header>

          <div class="tokens__block" id="tokens-color" data-spec>
            <h3>Color</h3>
            {colorGroups.map((group) => (
              <div class="swatch-group">
                <p class="swatch-group__name">{group.name}{group.note && <span> {group.note}</span>}</p>
                <ul class="swatches">
                  {group.swatches.map((swatch) => (
                    <li class="swatch">
                      <span class="swatch__chip" style={`background: var(${swatch.token});`}></span>
                      <span class="swatch__token">{swatch.token}</span>
                      <span class="swatch__hex">{swatch.hex}</span>
                      <span class="swatch__role">{swatch.role}</span>
                      {swatch.ratio && <span class="swatch__ratio">{swatch.ratio}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="tokens__block" id="tokens-type" data-spec>
            <h3>Type</h3>
            <p class="tokens__note">Schibsted Grotesk sets everything people read: headlines, UI, and body copy. Headlines run heavy with tight tracking. JetBrains Mono is kept for what is literally code: the logotype, code samples, and keyboard keys.</p>
            <ol class="type-scale">
              {typeScale.map((step) => (
                <li class="type-step">
                  <span class="type-step__meta"><code>{step.token}</code> {step.px}px, {step.role}</span>
                  <span class:list={['type-step__sample', step.display ? 'type-step__sample--display' : 'type-step__sample--body']} style={`font-size: var(${step.token});`}>
                    {step.display ? 'Chart the decision, not the data' : 'Lead with the takeaway, then show the evidence that backs it up.'}
                  </span>
                </li>
              ))}
            </ol>
          </div>

          <div class="tokens__block" id="tokens-space" data-spec>
            <h3>Space</h3>
            <p class="tokens__note">A 4px base. Tight steps inside a group, larger steps between groups.</p>
            <ol class="space-scale">
              {spaceScale.map((step) => (
                <li class="space-step">
                  <code>{step.token}</code>
                  <span class="space-step__bar" style={`width: var(${step.token});`}></span>
                  <span class="space-step__px">{step.rem * 16}px</span>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <div class="folder" id="folder-brand">
          <p class="folder__name">brand</p>

          <Spec name="Logotype" id="component-logotype" what="The (jdegbau)=>{} text logo. The only place the mark's markup and colors are defined." props="href, size, cursor, theme, label, class">
            <div class="component-logotype">
              <Logotype href={null} size="sm" />
              <Logotype href={null} />
              <Logotype href={null} size="lg" />
              <Logotype href={null} size="xl" />
              <Logotype href={null} size="lg" cursor={false} />
              <div class="component-logotype__light">
                <Logotype href={null} size="lg" theme="light" cursor={false} />
              </div>
            </div>
          </Spec>

          <Spec name="Icon" id="component-icon" what="Inline SVG icons that inherit text size and color, with no third-party icon script." props="name, label">
            <p class="icon-demo">
              <Icon name="linkedin-in" label="LinkedIn" />
              <Icon name="github" label="GitHub" />
              <Icon name="instagram" label="Instagram" />
              <Icon name="threads" label="Threads" />
              <Icon name="bluesky" label="Bluesky" />
              <Icon name="x-twitter" label="X" />
              <Icon name="calendar-days" label="Calendar" />
              <Icon name="clock" label="Clock" />
              <Icon name="envelope" label="Email" />
            </p>
          </Spec>

          <Spec name="Image" id="component-image" what="Image wrapper with consistent loading attributes. Use it instead of a raw img tag." props="src, alt, loading, decoding, class">
            <div class="image-demo">
              <Image src="/assets/img/seo-data-viz.png" alt="A dog at a desk surrounded by SEO dashboards" loading="lazy" decoding="async" />
            </div>
          </Spec>

          <Spec name="Logos" id="component-logos" what="One-color client logos sized to equal visual weight, in one row that becomes a marquee when there isn't room." props="logos, label, caption" flush>
            <Logos />
          </Spec>

          <Spec name="ChartGlyph" id="component-chartglyph" what="Small chart symbols in the site's chart style: context in the text color, one orange mark. The icon set for topics and services." props="name, size, label, class">
            <div class="glyph-grid">
              {coverKinds.map(([name]) => (
                <div class="glyph-grid__item">
                  <ChartGlyph name={name as any} size={32} />
                  <code>{name}</code>
                </div>
              ))}
            </div>
          </Spec>

          <Spec name="PostCover" id="component-postcover" what="Generated cover art in the brand's chart style: a scene filled with details from the post (its URL, query, code, questions), or a chart for posts about data. Set it with cover in the post's front matter; posts without one get their topic's default." props="seed, cover, kind, data, label, ratio, class" file="src/components/PostCover.astro + src/lib/cover-scenes.mjs + src/lib/cover-art.mjs">
            <p class="demo-label">Covers in use, newest first. Look here for repeats before publishing; set <code>cover</code> in a post's front matter to change one (see "Post covers" in the components README).</p>
            <div class="cover-grid">
              {allPosts.map((post) => (
                <div class="cover-grid__item">
                  <PostCover seed={post.coverSeed} cover={post.cover} label={post.topicLabel} />
                  <p><strong>{post.title}</strong><br /><code>{post.cover.scene}{post.cover.kind ? `: ${post.cover.kind}` : ''}</code>{post.cover.data && ' · real data'}</p>
                </div>
              ))}
            </div>

            <p class="demo-label">Every scene, and the story it fits. Fill it with details from the post; these use sample details:</p>
            <div class="cover-grid">
              {sceneDemos.map(([scene, cover]) => (
                <div class="cover-grid__item">
                  <PostCover seed={`demo-${scene}`} cover={cover} />
                  <p><code>{scene}</code><br />{SCENES[scene as keyof typeof SCENES]}</p>
                </div>
              ))}
            </div>

            <p class="demo-label">Every chart (<code>scene: chart</code>), and the story it fits. Chart covers without a <code>kind</code> rotate through their topic's set:</p>
            <ul class="cover-topics">
              {Object.entries(TOPICS).map(([key, topic]) => (
                <li><strong>{topic.label}</strong> (<code>{key}</code>): {topic.kinds.map((kind) => <code>{kind}</code>)}</li>
              ))}
            </ul>
            <div class="cover-grid">
              {coverKinds.map(([kind, use]) => (
                <div class="cover-grid__item">
                  <PostCover seed={`demo-${kind}`} kind={kind} />
                  <p><code>{kind}</code><br />{use}</p>
                </div>
              ))}
            </div>
          </Spec>

          <Spec name="Portrait" id="component-portrait" what="Josh's photo as AVIF, WebP, and JPEG with the site's graded photo treatment, as a rectangle or a circle." props="crop, photo, alt, shape, treatment, sizes, caption, loading, class">
            <div class="portrait-demo">
              <Portrait sizes="14rem" caption={'crop="portrait" (graded)'} />
              <Portrait sizes="14rem" treatment="natural" caption={'treatment="natural"'} />
              <Portrait crop="avatar" shape="circle" sizes="6rem" alt="" class="portrait-demo__avatar" caption={'crop="avatar" shape="circle"'} />
            </div>
          </Spec>
        </div>

        <div class="folder" id="folder-page-sections">
          <p class="folder__name">page sections</p>

          <Spec name="Section" id="component-section" what="A page section with an optional eyebrow, title, and lede. Split puts the header in a left column that stays in view while the content scrolls." props="title, eyebrow, lede, layout, tone, width, tight, headingLevel, id, class (slots: default, actions)" flush>
            <Section layout="split" tone="band" eyebrow={'layout="split"'} title="Header on the left, content on the right" lede="Stacks on narrow screens. Use it to break up a run of stacked sections.">
              <p>Section content goes in the default slot. On wide screens the header column stays in view while this column scrolls past.</p>
              <p>Other layouts: <code>stacked</code> (the default) and <code>center</code>.</p>
            </Section>
          </Spec>

          <Spec name="Hero" id="component-hero" what="Page header: a compact intro, the home page's display headline, a full-width hero with an optional background image, or a split hero. Anything in the media slot sits beside the text." props="variant, backgroundImage, imageSrc, imageAlt, containerWidth, class (slots: default, media)" flush>
            <div class="variant">
              <p class="variant__label"><code>variant="intro"</code></p>
              <Hero variant="intro" containerWidth="narrow">
                <span class="jdb-eyebrow">About</span>
                <h2>Compact page introduction</h2>
                <p class="jdb-hero__lede">A concise introduction with the same structure used across informational pages.</p>
              </Hero>
            </div>
            <div class="variant">
              <p class="variant__label"><code>variant="full" backgroundImage</code></p>
              <Hero variant="full" backgroundImage="/assets/img/seo-data-viz.png">
