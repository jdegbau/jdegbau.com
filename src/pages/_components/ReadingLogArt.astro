---
/**
 * Illustration of the Reading Log's Stats page for /projects/reading-log/.
 * The app is private, so this stands in for a screenshot: the activity
 * line colored by book, a goal ring and the bookshelf of spines, drawn in
 * the app's own paper-and-ink palette. Shapes only; no real numbers.
 */
const W = 1200;
const H = 780;

// Book colors, roughly the accent colors the app pulls from covers.
const books = ['#b4532a', '#2f6f73', '#7a5c99', '#c08a2b', '#3d5a80', '#8a3b4e'];

// Daily pages: a gentle, seeded wave so the line looks like real reading.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const days = 42;
const values = Array.from({ length: days }, (_, i) => {
  const base = 26 + 14 * Math.sin(i / 4.2) + 8 * Math.sin(i / 1.7);
  return Math.max(0, base + rand() * 18 - (i % 9 === 4 ? 30 : 0));
});
const chart = { x: 80, y: 250, w: 640, h: 200 };
const max = Math.max(...values);
const pt = (v: number, i: number) => [chart.x + (i / (days - 1)) * chart.w, chart.y + chart.h - (v / max) * chart.h] as const;
// Each run of days belongs to one book; the line takes that book's color.
const runs = [
  { from: 0, to: 9, book: 0 },
  { from: 9, to: 18, book: 1 },
  { from: 18, to: 27, book: 2 },
  { from: 27, to: 35, book: 3 },
  { from: 35, to: days - 1, book: 4 },
];
const segments = runs.map((run) => ({
  color: books[run.book],
  d: values.slice(run.from, run.to + 1).map((v, j) => `${j ? 'L' : 'M'}${pt(v, run.from + j).map((n) => n.toFixed(1)).join(' ')}`).join(' '),
}));
const area = `M${chart.x} ${chart.y + chart.h} ` + values.map((v, i) => `L${pt(v, i).map((n) => n.toFixed(1)).join(' ')}`).join(' ') + ` L${chart.x + chart.w} ${chart.y + chart.h} Z`;
const last = pt(values[days - 1], days - 1);

// Bookshelf: spines sized by length, with a bookend between groups.
const spines: { x: number; w: number; h: number; color: string }[] = [];
let sx = 92;
for (let i = 0; i < 34 && sx < 1090; i++) {
  if (i === 12 || i === 23) sx += 26; // bookends
  const w = 18 + Math.round(rand() * 22);
  const h = 104 + Math.round(rand() * 46);
  spines.push({ x: sx, w, h, color: books[i % books.length] });
  sx += w + 3;
}
const shelfY = 724;

const goal = 0.68;
const ringR = 74;
const ringC = 2 * Math.PI * ringR;
---

<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <rect width={W} height={H} fill="#fbfaf8" />

  <!-- Top bar -->
  <rect width={W} height="64" fill="#ffffff" />
  <line x1="0" y1="64" x2={W} y2="64" stroke="#e7e5e4" />
  <text x="48" y="41" font-family="Georgia, 'Times New Roman', serif" font-size="22" font-weight="600" fill="#1c1917">Reading Log</text>
  <g font-family="system-ui, sans-serif" font-size="15" fill="#78716c">
    <text x="840" y="39">Library</text>
    <text x="922" y="39" fill="#1c1917" font-weight="600">Stats</text>
    <text x="990" y="39">Goals</text>
  </g>
  <rect x="922" y="56" width="40" height="3" rx="1.5" fill="#b4532a" />
  <circle cx="1120" cy="33" r="15" fill="#e7e5e4" />

  <text x="48" y="128" font-family="Georgia, 'Times New Roman', serif" font-size="40" font-weight="600" fill="#1c1917">Stats</text>

  <!-- Activity card -->
  <rect x="48" y="160" width="704" height="322" rx="14" fill="#ffffff" stroke="#e7e5e4" />
  <text x="80" y="198" font-family="system-ui, sans-serif" font-size="12" letter-spacing="1.5" fill="#78716c">DAILY READING ACTIVITY</text>
  <rect x="80" y="210" width="120" height="10" rx="5" fill="#f0eeeb" />
  {[0, 1, 2, 3].map((i) => (
    <line x1={chart.x} x2={chart.x + chart.w} y1={chart.y + (i * chart.h) / 3} y2={chart.y + (i * chart.h) / 3} stroke="#f0eeeb" />
  ))}
  <path d={area} fill="#b4532a" opacity="0.06" />
  {segments.map((s) => (
    <path d={s.d} fill="none" stroke={s.color} stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round" />
  ))}
  <circle cx={last[0]} cy={last[1]} r="6" fill="#ffffff" stroke={books[4]} stroke-width="3" />
  <!-- The active book's cover rides the end of the line. -->
  <rect x={last[0] - 26} y={chart.y - 64} width="40" height="58" rx="3" fill={books[4]} />
  <rect x={last[0] - 20} y={chart.y - 52} width="28" height="4" rx="2" fill="#ffffff" opacity="0.7" />
  <rect x={last[0] - 20} y={chart.y - 44} width="18" height="4" rx="2" fill="#ffffff" opacity="0.5" />

  <!-- Goal card -->
  <rect x="776" y="160" width="376" height="322" rx="14" fill="#ffffff" stroke="#e7e5e4" />
  <text x="808" y="198" font-family="system-ui, sans-serif" font-size="12" letter-spacing="1.5" fill="#78716c">YEARLY GOAL</text>
  <g transform="translate(964 330)">
    <circle r={ringR} fill="none" stroke="#f0eeeb" stroke-width="16" />
    <circle r={ringR} fill="none" stroke="#2f6f73" stroke-width="16" stroke-linecap="round"
      stroke-dasharray={`${(ringC * goal).toFixed(1)} ${ringC.toFixed(1)}`} transform="rotate(-90)" />
    <text y="8" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="24" fill="#1c1917">On pace</text>
  </g>
  <rect x="884" y="436" width="160" height="10" rx="5" fill="#f0eeeb" />

  <!-- Bookshelf card -->
  <rect x="48" y="506" width="1104" height="250" rx="14" fill="#ffffff" stroke="#e7e5e4" />
  <text x="80" y="544" font-family="system-ui, sans-serif" font-size="12" letter-spacing="1.5" fill="#78716c">BOOKSHELF</text>
  {spines.map((s) => (
    <g>
      <rect x={s.x} y={shelfY - s.h} width={s.w} height={s.h} rx="2" fill={s.color} />
      <rect x={s.x + s.w / 2 - 2} y={shelfY - s.h + 14} width="4" height={s.h * 0.45} rx="2" fill="#ffffff" opacity="0.55" />
    </g>
  ))}
  <rect x="80" y={shelfY} width="1040" height="6" rx="3" fill="#d6d3d1" />
</svg>
