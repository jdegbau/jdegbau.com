---
/**
 * Generated cover art in the brand's chart style: a scene built from details
 * in the post (a URL, a query, code, questions) or a chart, seeded so the
 * same seed always draws the same picture. Blog cards, the article header,
 * and the social share image all use it, so a post looks the same
 * everywhere. See src/lib/cover-scenes.mjs and src/lib/cover-art.mjs.
 */
import { coverIcon, coverSvg } from '../lib/cover-art.mjs';
import ChartGlyph from './ChartGlyph.astro';

interface Props {
  /** Usually the post slug. Same seed, same picture. */
  seed: string;
  /** The scene to draw, e.g. post.cover. See src/lib/cover-scenes.mjs. */
  cover?: { scene: string; [key: string]: unknown };
  /** Shorthand for a chart cover: one of KINDS in src/lib/cover-art.mjs. */
  kind?: string;
  /** Real numbers for a chart cover (trend, compare, funnel, histogram). */
  data?: number[];
  /** Topic name shown as a small label on the cover, e.g. "SEO". */
  label?: string;
  /** Width to height. */
  ratio?: '16/9' | '21/9' | '4/3' | '1/1';
  class?: string;
}

const { seed, cover, kind = 'trend', data, label, ratio = '16/9', class: className } = Astro.props;
const spec = cover ?? { scene: 'chart', kind, data };
const [rw, rh] = ratio.split('/').map(Number);
// Taller boxes get a taller canvas, so the whole picture stays in view.
const svg = coverSvg({ seed, cover: spec, aspect: rw / rh });
---

<div class:list={['jdb-cover', className]} style={`aspect-ratio: ${ratio}`}>
  <Fragment set:html={svg} />
  {label && (
    <span class="jdb-cover__label">
      <ChartGlyph name={coverIcon(spec) as any} size={14} />
      {label}
    </span>
  )}
</div>

<style>
  .jdb-cover {
    position: relative;
    overflow: hidden;
    background: var(--jdb-surface-band);
  }

  .jdb-cover :global(svg:not(.jdb-glyph)) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform var(--jdb-dur-slow) var(--jdb-ease);
  }

  .jdb-cover__label {
    position: absolute;
    top: var(--jdb-s-3);
    left: var(--jdb-s-3);
    display: inline-flex;
    align-items: center;
    gap: .45em;
    padding: .3em .65em .3em .5em;
    font-size: var(--jdb-fs-xs);
    font-weight: var(--jdb-fw-medium);
    line-height: 1.2;
    color: var(--jdb-fg);
    background: rgba(10, 21, 38, .72);
    border: 1px solid var(--jdb-line-strong);
    border-radius: var(--jdb-r-pill);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
</style>
