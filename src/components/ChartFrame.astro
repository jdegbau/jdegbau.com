---
/**
 * The one wrapper for every chart on the site: a title that states the
 * takeaway, a one-line explanation, the chart, a source line, and an
 * optional "View the data" table for screen readers and skeptics.
 *
 * Put any chart in the default slot: TrendChart, ChartPlayground's canvas,
 * an inline SVG, or an image.
 */
interface Props {
  /** The takeaway, as a sentence: "Clicks rose 65% after the refresh", not "Clicks by week". */
  title?: string;
  /** One line on what's plotted: the measure, the unit, the period. */
  dek?: string;
  /** Where the data comes from. */
  source?: string;
  /** Optional data table shown under "View the data". */
  table?: { columns: string[]; rows: (string | number)[][] };
  /** Element for the title. Use h3 inside posts; the default p suits standalone charts. */
  titleAs?: 'p' | 'h2' | 'h3' | 'h4';
  /** `plain` drops the card surface, for charts inside an existing card. */
  surface?: 'card' | 'plain';
  class?: string;
}

const { title, dek, source, table, titleAs = 'p', surface = 'card', class: className } = Astro.props;
const Title = titleAs;
const hasFoot = Boolean(source || table);
---

<figure class:list={['jdb-chartframe', `jdb-chartframe--${surface}`, className]}>
  {(title || dek) && (
    <figcaption class="jdb-chartframe__head">
      {title && <Title class="jdb-chartframe__title">{title}</Title>}
      {dek && <p class="jdb-chartframe__dek">{dek}</p>}
    </figcaption>
  )}

  <div class="jdb-chartframe__chart">
    <slot />
  </div>

  {hasFoot && (
    <div class="jdb-chartframe__foot">
      {source && <p class="jdb-chartframe__source">{source}</p>}
      {table && (
        <details class="jdb-chartframe__data">
          <summary>View the data</summary>
          <div class="jdb-chartframe__table">
            <table>
              <thead>
                <tr>{table.columns.map((column) => <th scope="col">{column}</th>)}</tr>
              </thead>
              <tbody>
                {table.rows.map((row) => (
                  <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}
    </div>
  )}
</figure>

<style>
  .jdb-chartframe {
    margin: 0;
    min-width: 0;
  }

  :global(.jdb-prose) .jdb-chartframe {
    margin-block: var(--jdb-s-7);
  }

  .jdb-chartframe--card {
    padding: var(--jdb-s-5) var(--jdb-s-5) var(--jdb-s-4);
    background: var(--jdb-surface-card);
    border: 1px solid var(--jdb-line);
    border-radius: var(--jdb-r-lg);
  }

  @media (min-width: 48rem) {
    .jdb-chartframe--card {
      padding: var(--jdb-s-6) var(--jdb-s-6) var(--jdb-s-5);
    }
  }

  .jdb-chartframe__head {
    margin-bottom: var(--jdb-s-5);
  }

  .jdb-chartframe__title {
    margin: 0;
    font-size: var(--jdb-fs-md);
    font-weight: var(--jdb-fw-bold);
    line-height: var(--jdb-lh-snug);
    letter-spacing: -0.01em;
    color: var(--jdb-fg);
    text-wrap: balance;
  }

  .jdb-chartframe__dek {
    margin: var(--jdb-s-1) 0 0;
    font-size: var(--jdb-fs-sm);
    color: var(--jdb-fg-muted);
  }

  .jdb-chartframe__chart {
    position: relative;
    min-width: 0;
  }

  .jdb-chartframe__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--jdb-s-2) var(--jdb-s-4);
    margin-top: var(--jdb-s-4);
    padding-top: var(--jdb-s-3);
    border-top: 1px solid var(--jdb-line);
  }

  .jdb-chartframe__source {
    margin: 0;
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
  }

  .jdb-chartframe__data {
    font-size: var(--jdb-fs-xs);
  }

  .jdb-chartframe__data[open] {
    flex-basis: 100%;
  }

  .jdb-chartframe__data summary {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--jdb-orange-400);
    cursor: pointer;
  }

  .jdb-chartframe__data summary:hover {
    color: #fff;
  }

  .jdb-chartframe__table {
    max-height: 16rem;
    margin-top: var(--jdb-s-2);
    overflow: auto;
    border: 1px solid var(--jdb-line);
    border-radius: var(--jdb-r-md);
  }

  .jdb-chartframe__table table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--jdb-fs-xs);
  }

  .jdb-chartframe__table th,
  .jdb-chartframe__table td {
    padding: var(--jdb-s-2) var(--jdb-s-3);
    text-align: left;
    border-bottom: 1px solid var(--jdb-line);
    color: var(--jdb-fg-dim);
  }

  .jdb-chartframe__table thead th {
    position: sticky;
    top: 0;
    background: var(--jdb-surface-band);
    color: var(--jdb-fg-muted);
    font-weight: var(--jdb-fw-medium);
  }

  .jdb-chartframe__table td {
    text-align: right;
  }
</style>
