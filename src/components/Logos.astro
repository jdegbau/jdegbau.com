---
/**
 * A row of one-color client logos. Logos are white silhouettes (built by
 * scripts/mono-logos.mjs) shown at reduced opacity, so they read as one set.
 * Each logo is sized to the same visual area rather than the same height,
 * so wide wordmarks and compact marks look equally weighted.
 */
interface Logo {
  src: string;
  alt: string;
  /** Intrinsic size of the file, used for optical sizing. */
  width: number;
  height: number;
  /** Visual weight multiplier; raise it for logos with thin, small lettering. */
  weight?: number;
}

interface Props {
  logos?: Logo[];
  /** Accessible name for the list. */
  label?: string;
  /** Short visible line above the logos. Pass an empty string to hide it. */
  caption?: string;
}

const {
  logos = [
    { src: '/assets/img/logos/mono/rocket-clicks.png', alt: 'Rocket Clicks', width: 816, height: 180 },
    { src: '/assets/img/logos/mono/fireandspark.png', alt: 'Fire&Spark', width: 938, height: 200 },
    { src: '/assets/img/logos/mono/activities-tours-marketing.png', alt: 'Activities & Tours Marketing by TRK Creative Group', width: 867, height: 96, weight: 1.3 },
    { src: '/assets/img/logos/mono/ellsworth.png', alt: 'Ellsworth Adhesives', width: 355, height: 53 },
  ],
  label = 'Organizations Josh has worked with',
  caption = 'Where I’ve done the work',
} = Astro.props;

// Same visual area for every logo: height = sqrt(area / aspect ratio).
const AREA = 5600;
const sized = logos.map((logo) => {
  const aspect = logo.width / logo.height;
  const h = Math.sqrt((AREA * (logo.weight ?? 1)) / aspect);
  return { ...logo, displayWidth: Math.round(h * aspect), displayHeight: Math.round(h) };
});
---

<section class="jdb-section jdb-section--tight">
  <div class="jdb-container">
    {caption && <p class="jdb-logos__caption">{caption}</p>}
    <div class="jdb-logos">
      <div class="jdb-logos__viewport">
        <div class="jdb-logos__track">
          <ul class="jdb-logo-grid" aria-label={label}>
            {sized.map((logo) => (
              <li class="jdb-logo-item">
                <img src={logo.src} alt={logo.alt} width={logo.displayWidth} height={logo.displayHeight} style={`--w: ${logo.displayWidth}px`} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
          {/* Duplicate set so the narrow-screen marquee loops seamlessly. Hidden on wide screens. */}
          <ul class="jdb-logo-grid jdb-logo-grid--clone" aria-hidden="true">
            {sized.map((logo) => (
              <li class="jdb-logo-item">
                <img src={logo.src} alt="" width={logo.displayWidth} height={logo.displayHeight} style={`--w: ${logo.displayWidth}px`} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .jdb-logos {
    --jdb-logos-gap: clamp(var(--jdb-s-3), 2vw, var(--jdb-s-5));
    container: jdb-logos / inline-size;
  }

  .jdb-logo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--jdb-logos-gap);
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jdb-logo-grid--clone {
    display: none;
  }

  .jdb-logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(4rem, 7vw, 5rem);
    padding: 0;
  }

  .jdb-logos__caption {
    margin: 0 0 var(--jdb-s-5);
    font-size: var(--jdb-fs-sm);
    font-weight: var(--jdb-fw-medium);
    color: var(--jdb-fg-muted);
    text-align: center;
  }

  .jdb-logo-item img {
    width: min(100%, var(--w));
    height: auto;
    object-fit: contain;
    opacity: .62;
    transition: opacity var(--jdb-t-fast);
  }

  .jdb-logo-item:hover img {
    opacity: .9;
  }

  /*
   * When the row no longer has room for every logo at a comfortable size
   * (instead of squeezing or wrapping to a second line), switch to a
   * continuously scrolling marquee.
   */
  @container jdb-logos (max-width: 46rem) {
    .jdb-logos__viewport {
      /* Logos sit in a single scrolling row here, so give them more air. */
      --jdb-logos-gap: var(--jdb-s-8);
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    }

    .jdb-logos__track {
      display: flex;
      width: max-content;
      animation: jdb-logos-scroll 28s linear infinite;
    }

    .jdb-logos__viewport:hover .jdb-logos__track,
    .jdb-logos__viewport:focus-within .jdb-logos__track {
      animation-play-state: paused;
    }

    .jdb-logo-grid,
    .jdb-logo-grid--clone {
      display: flex;
      flex-wrap: nowrap;
      /* Trailing gap keeps spacing even where the two sets meet. */
      padding-inline-end: var(--jdb-logos-gap);
    }

    .jdb-logo-item {
      flex: 0 0 auto;
      min-height: 4rem;
    }

    .jdb-logo-item img {
      width: calc(var(--w) * .85);
      max-width: none;
    }
  }

  /* No auto-scroll for reduced motion: fall back to a swipeable row. */
  @media (prefers-reduced-motion: reduce) {
    @container jdb-logos (max-width: 46rem) {
      .jdb-logos__viewport {
        overflow-x: auto;
        scroll-snap-type: x proximity;
        scrollbar-width: none;
        -webkit-mask-image: none;
        mask-image: none;
      }

      .jdb-logos__viewport::-webkit-scrollbar {
        display: none;
      }

      .jdb-logos__track {
        animation: none;
      }

      .jdb-logo-grid--clone {
        display: none;
      }

      .jdb-logo-item {
        scroll-snap-align: start;
      }
    }
  }

  @keyframes jdb-logos-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
