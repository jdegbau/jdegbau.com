---
/**
 * Live Chart.js chart with optional toggles that change it, so readers can
 * see what a design choice does (sorting, labels, highlight, too many series…).
 *
 * Each control is a checkbox. When it is on, its `patch` is deep-merged into
 * the base config (objects merge, arrays and values replace). Colours can be
 * site tokens written as "var(--jdb-orange-500)".
 *
 * Chart.js and plugins load lazily, once per page, when the chart scrolls into view.
 * Always pass `alt`; add `table` for a screen-reader friendly copy of the data.
 */
import type { ChartPluginName } from '../lib/chart-loader';
import ChartFrame from './ChartFrame.astro';

interface Control {
  label: string;
  patch: Record<string, unknown>;
  /** Start switched on. */
  checked?: boolean;
}

interface Props {
  id: string;
  /** Chart.js chart type, e.g. "bar", "line", "sankey", "treemap". */
  type: string;
  data: Record<string, unknown>;
  options?: Record<string, unknown>;
  plugins?: ChartPluginName[];
  controls?: Control[];
  /** Text description of what the chart shows (used as the canvas label). */
  alt: string;
  /** The takeaway, as a sentence (ChartFrame title). */
  title?: string;
  /** One line on what's plotted. */
  dek?: string;
  /** Where the data comes from. */
  source?: string;
  /** Older name for `dek`; still works. */
  caption?: string;
  /** Optional data table shown in a collapsible "View the data" panel. */
  table?: { columns: string[]; rows: (string | number)[][] };
  /** Chart height in px. Width always fills the column. */
  height?: number;
  class?: string;
}

const {
  id,
  type,
  data,
  options = {},
  plugins = [],
  controls = [],
  alt,
  title,
  dek,
  source,
  caption,
  table,
  height = 360,
  class: className,
} = Astro.props;

const config = { type, data, options: { responsive: true, maintainAspectRatio: false, ...options } };
const payload = { config, plugins, patches: controls.map((control) => control.patch) };
---

<ChartFrame title={title} dek={dek ?? caption} source={source} table={table} class:list={['jdb-playground', className]}>
  <div class="jdb-playground__body" data-playground id={id}>
    {controls.length > 0 && (
      <fieldset class="jdb-playground__controls">
        <legend>Try it</legend>
        {controls.map((control, index) => (
          <label class="jdb-playground__toggle">
            <input type="checkbox" data-playground-control={index} checked={control.checked} />
            <span>{control.label}</span>
          </label>
        ))}
      </fieldset>
    )}
    <div class="jdb-playground__canvas" style={`height:${height}px`}>
      <canvas role="img" aria-label={alt}>{alt}</canvas>
      <p class="jdb-playground__status" data-playground-status>Loading chart…</p>
    </div>
    <script type="application/json" data-playground-config set:html={JSON.stringify(payload)} />
  </div>
</ChartFrame>

<style>
  :global(.jdb-playground) {
    margin: var(--jdb-s-6) 0;
  }

  .jdb-playground__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--jdb-s-2) var(--jdb-s-4);
    margin: 0 0 var(--jdb-s-4);
    padding: 0 0 var(--jdb-s-3);
    border: 0;
    border-bottom: 1px solid var(--jdb-line);
  }

  .jdb-playground__controls legend {
    float: left;
    margin-right: var(--jdb-s-2);
    padding: 0;
    font-family: var(--jdb-font-sans);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-orange-400);
    line-height: 1.9;
  }

  .jdb-playground__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--jdb-s-2);
    font-size: var(--jdb-fs-sm);
    color: var(--jdb-fg-dim);
    cursor: pointer;
  }

  .jdb-playground__toggle input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--jdb-orange-500);
  }

  .jdb-playground__canvas {
    position: relative;
  }

  .jdb-playground__status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-family: var(--jdb-font-sans);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
  }

  .jdb-playground__status[hidden] {
    display: none;
  }


</style>

<script>
  import { loadChart, resolveCssVars, type ChartPluginName } from '../lib/chart-loader';

  type Payload = {
    config: Record<string, unknown>;
    plugins: ChartPluginName[];
    patches: Record<string, unknown>[];
  };

  const isObject = (value: unknown): value is Record<string, unknown> =>
    Boolean(value) && typeof value === 'object' && !Array.isArray(value);

  // Objects merge key by key; arrays and plain values replace.
  const merge = (base: unknown, patch: unknown): unknown => {
    if (!isObject(base) || !isObject(patch)) return structuredClone(patch);
    const result: Record<string, unknown> = { ...base };
    for (const [key, value] of Object.entries(patch)) result[key] = merge(base[key], value);
    return result;
  };

  const start = async (figure: HTMLElement) => {
    const source = figure.querySelector('[data-playground-config]');
    const canvas = figure.querySelector('canvas');
    const status = figure.querySelector<HTMLElement>('[data-playground-status]');
    if (!source?.textContent || !canvas) return;

    const payload: Payload = JSON.parse(source.textContent);
    const toggles = [...figure.querySelectorAll<HTMLInputElement>('[data-playground-control]')];

    try {
      const Chart = await loadChart(payload.plugins);
      let chart: { destroy(): void } | undefined;

      const render = () => {
        const config = toggles
          .filter((toggle) => toggle.checked)
          .reduce((current, toggle) => merge(current, payload.patches[Number(toggle.dataset.playgroundControl)]), structuredClone(payload.config));
        chart?.destroy();
        chart = new Chart(canvas, resolveCssVars(config));
      };

      toggles.forEach((toggle) => toggle.addEventListener('change', render));
      render();
      if (status) status.hidden = true;
    } catch (error) {
      if (status) {
        const hasTable = Boolean(figure.closest('figure')?.querySelector('.jdb-chartframe__data'));
        status.textContent = `The interactive chart could not load.${hasTable ? ' Use “View the data” below.' : ''}`;
      }
      console.error(error);
    }
  };

  const figures = document.querySelectorAll<HTMLElement>('[data-playground]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          start(entry.target as HTMLElement);
        });
      },
      { rootMargin: '200px 0px' },
    );
    figures.forEach((figure) => observer.observe(figure));
  } else {
    figures.forEach(start);
  }
</script>
