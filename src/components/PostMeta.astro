---
/**
 * Slim bar for long posts: the post title, share links, and reading
 * progress. It stays out of the way until the reader scrolls past the
 * article header (the element marked `data-article-header`), then slides
 * in under the site header.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  /** Absolute URL of the post. */
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
---

<div class="post-bar" data-post-bar>
  <div class="jdb-container post-bar__inner">
    <p class="post-bar__title" aria-hidden="true">{title}</p>
    <div class="post-bar__share" role="group" aria-label="Share this post">
      <span class="post-bar__label">Share</span>
      <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" data-jdb-track="share-x">
        <Icon name="x-twitter" />
      </a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" data-jdb-track="share-linkedin">
        <Icon name="linkedin" />
      </a>
      <a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodedUrl}`} aria-label="Share by email" data-jdb-track="share-email">
        <Icon name="envelope" />
      </a>
      <button type="button" class="post-bar__copy" data-copy-url={url} data-jdb-track="share-copy">
        <span class="jdb-icon jdb-icon--copy" aria-hidden="true"></span>
        <span data-copy-label>Copy link</span>
      </button>
    </div>
  </div>

  <div class="post-meta__progress" aria-hidden="true">
    <div class="post-meta__progress-bar" id="progress-bar"></div>
  </div>
</div>

<style>
  .post-bar {
    position: fixed;
    top: var(--jdb-header-h);
    left: 0;
    right: 0;
    z-index: 70;
    background: rgba(10, 21, 38, .88);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--jdb-line);
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: transform var(--jdb-dur-slow) var(--jdb-ease), opacity var(--jdb-dur) ease, visibility 0s linear var(--jdb-dur-slow);
  }

  .post-bar.is-visible {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition: transform var(--jdb-dur-slow) var(--jdb-ease), opacity var(--jdb-dur) ease, visibility 0s;
  }

  .post-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--jdb-s-4);
    min-height: 3rem;
  }

  .post-bar__title {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-size: var(--jdb-fs-sm);
    font-weight: var(--jdb-fw-semibold);
    color: var(--jdb-fg);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .post-bar__share {
    display: flex;
    align-items: center;
    gap: var(--jdb-s-1);
    flex: 0 0 auto;
  }

  .post-bar__label {
    margin-right: var(--jdb-s-1);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
  }

  .post-bar__share a,
  .post-bar__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4em;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 .5rem;
    font: inherit;
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-dim);
    text-decoration: none;
    background: transparent;
    border: 0;
    border-radius: var(--jdb-r-md);
    cursor: pointer;
    transition: background var(--jdb-t-fast), color var(--jdb-t-fast);
  }

  .post-bar__share a:hover,
  .post-bar__copy:hover {
    color: #fff;
    background: rgba(255, 255, 255, .06);
  }

  .post-bar__copy.is-copied {
    color: var(--jdb-good);
  }

  .post-meta__progress {
    position: relative;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, .06);
    overflow: hidden;
  }

  /* Grows from the center out. */
  .post-meta__progress-bar {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    width: 0;
    background: linear-gradient(to right, var(--jdb-orange-500), var(--jdb-navy-800), var(--jdb-orange-500));
    transform: translateX(-50%);
  }

  @media (max-width: 36rem) {
    .post-bar__title,
    .post-bar__label {
      display: none;
    }

    .post-bar__inner {
      justify-content: center;
    }
  }

  @media print {
    .post-bar { display: none; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-post-bar]');
  const header = document.querySelector('[data-article-header]');

  if (bar && header && 'IntersectionObserver' in window) {
    // Show the bar once the article header has scrolled up out of view.
    new IntersectionObserver(([entry]) => {
      const past = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.classList.toggle('is-visible', past);
    }).observe(header);
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-copy-url]');
  copy?.addEventListener('click', async () => {
    const label = copy.querySelector('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(copy.dataset.copyUrl ?? location.href);
      copy.classList.add('is-copied');
      if (label) label.textContent = 'Copied';
      setTimeout(() => {
        copy.classList.remove('is-copied');
        if (label) label.textContent = 'Copy link';
      }, 2000);
    } catch {
      // Clipboard blocked (permissions, older browser): let them copy by hand.
      window.prompt('Copy this link:', copy.dataset.copyUrl ?? location.href);
    }
  });
</script>
