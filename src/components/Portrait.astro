---
/**
 * Josh's photo (or another photo prepared the same way), served as AVIF and
 * WebP with a JPEG fallback, with the site's photo treatment applied.
 *
 * Treatments:
 *   graded   (default) slightly cooler and calmer, with a navy shade at the
 *            bottom, so the photo sits in the dark page instead of on it
 *   natural  untouched
 * Every photo on the site should use the same treatment so they read as one set.
 */
import { author } from '../data/author';

interface PhotoSource {
  /** Path without the `-<width>.<ext>` suffix. */
  base: string;
  /** Widths that exist as files. */
  widths: number[];
  /** Intrinsic size of the largest file. */
  width: number;
  height: number;
}

interface Props {
  /** Which of Josh's crops to use. Ignored when `photo` is set. */
  crop?: 'portrait' | 'avatar';
  /** A different photo, prepared as AVIF/WebP/JPEG at each width. */
  photo?: PhotoSource;
  /** Empty string when the name is printed right beside the photo. */
  alt?: string;
  shape?: 'rect' | 'circle';
  treatment?: 'graded' | 'natural';
  /** The `sizes` attribute: how wide the photo renders. */
  sizes?: string;
  /** Short caption under the photo. */
  caption?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  crop = 'portrait',
  photo,
  alt = `Photo of ${author.name}`,
  shape = 'rect',
  treatment = 'graded',
  sizes = '(min-width: 64rem) 24rem, 90vw',
  caption,
  loading = 'lazy',
  class: className,
} = Astro.props;

const source: PhotoSource = photo ?? author.photo[crop];
const set = (ext: string) => source.widths.map((w) => `${source.base}-${w}.${ext} ${w}w`).join(', ');
const largest = Math.max(...source.widths);
const Wrapper = caption ? 'figure' : 'div';
---

<Wrapper class:list={['jdb-portrait', `jdb-portrait--${shape}`, `jdb-portrait--${treatment}`, className]}>
  <div class="jdb-portrait__frame" style={`aspect-ratio: ${source.width} / ${source.height}`}>
    <picture>
      <source type="image/avif" srcset={set('avif')} sizes={sizes} />
      <source type="image/webp" srcset={set('webp')} sizes={sizes} />
      <img
        src={`${source.base}-${largest}.jpg`}
        srcset={set('jpg')}
        sizes={sizes}
        alt={alt}
        width={source.width}
        height={source.height}
        loading={loading}
        decoding="async"
        fetchpriority={loading === 'eager' ? 'high' : undefined}
      />
    </picture>
  </div>
  {caption && <figcaption class="jdb-portrait__caption">{caption}</figcaption>}
</Wrapper>

<style>
  .jdb-portrait {
    margin: 0;
  }

  .jdb-portrait__frame {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--jdb-surface-band);
    border-radius: var(--jdb-r-lg);
  }

  .jdb-portrait--rect .jdb-portrait__frame {
    border: 1px solid var(--jdb-line-strong);
  }

  .jdb-portrait--circle .jdb-portrait__frame {
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--jdb-line-strong);
  }

  .jdb-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Graded: cooler, calmer color, plus a navy shade at the bottom. */
  .jdb-portrait--graded img {
    filter: saturate(.72) contrast(1.06) brightness(.96);
  }

  .jdb-portrait--graded .jdb-portrait__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(10, 21, 38, .6), rgba(10, 21, 38, 0) 45%),
      linear-gradient(135deg, rgba(21, 42, 73, .35), rgba(255, 77, 0, .08));
    mix-blend-mode: multiply;
  }

  .jdb-portrait--circle.jdb-portrait--graded .jdb-portrait__frame::after {
    background: linear-gradient(135deg, rgba(21, 42, 73, .35), rgba(255, 77, 0, .08));
  }

  .jdb-portrait__caption {
    margin-top: var(--jdb-s-3);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
  }

  @media print {
    .jdb-portrait img { filter: none; }
    .jdb-portrait__frame::after { display: none; }
  }
</style>
