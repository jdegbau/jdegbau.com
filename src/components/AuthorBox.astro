---
/**
 * The author sign-off at the end of every post: a "Written by" block on the
 * site's graph paper. One column at every width: photo and name, then the
 * bio, then quiet text links. The photo is two grid squares, set on the grid.
 */
import { author } from '../data/author';
import Portrait from './Portrait.astro';

const linkedin = author.aiProfile.profiles.find((profile) => profile.name === 'LinkedIn');
---
<aside class="jdb-author" aria-label="About the author">
  <div class="jdb-author__head">
    {/* The name sits right beside the photo, so the image is decorative. */}
    <Portrait crop="avatar" alt="" sizes="96px" class="jdb-author__photo" />
    <div>
      <p class="jdb-author__eyebrow">Written by</p>
      <p class="jdb-author__name">{author.name}</p>
    </div>
  </div>

  <p class="jdb-author__bio">{author.bio}</p>

  <ul class="jdb-author__links">
    <li><a href="/about/">More about Josh</a></li>
    {linkedin && (
      <li>
        <a href={linkedin.url} target="_blank" rel="noopener noreferrer">
          LinkedIn <span class="jdb-icon jdb-icon--external jdb-author__ext" aria-hidden="true"></span><span class="jdb-sr-only">(opens in a new tab)</span>
        </a>
      </li>
    )}
    <li><a href={author.cta.href}>{author.cta.text}</a></li>
  </ul>
</aside>

<style>
  /* The padding is half a grid square, so the photo (two squares) lands
     exactly on the graph paper's lines. */
  .jdb-author {
    --pad: calc(var(--jdb-grid-size) / 2);
    /* A touch stronger than the hero's lines: this panel is small, so the
       grid needs to read without a large area behind it. */
    --line: rgb(255 255 255 / 0.07);
    position: relative;
    overflow: hidden;
    padding: var(--pad);
    background: var(--jdb-navy-900);
    border: 1px solid var(--jdb-line);
    border-radius: var(--jdb-r-lg);
    isolation: isolate;
  }

  /* Graph paper under a soft orange glow behind the photo, fading out
     toward the bottom right so the bio reads on a calm surface. */
  .jdb-author::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(circle at calc(var(--pad) + var(--jdb-grid-size)) calc(var(--pad) + var(--jdb-grid-size)), var(--jdb-hero-wash), transparent 14rem),
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 100% 100%, var(--jdb-grid-size) var(--jdb-grid-size), var(--jdb-grid-size) var(--jdb-grid-size);
    background-position: 0 0, calc(var(--pad) - 1px) 0, 0 calc(var(--pad) - 1px);
    -webkit-mask-image: radial-gradient(ellipse 120% 140% at 0 0, #000 30%, transparent 85%);
            mask-image: radial-gradient(ellipse 120% 140% at 0 0, #000 30%, transparent 85%);
  }

  .jdb-author__head {
    display: flex;
    align-items: center;
    gap: var(--pad);
  }

  .jdb-author :global(.jdb-author__photo) {
    flex: 0 0 auto;
    width: calc(var(--jdb-grid-size) * 2);
    margin: 0;
  }

  .jdb-author :global(.jdb-author__photo img) {
    border-radius: var(--jdb-r-md);
  }

  .jdb-author__eyebrow {
    margin: 0 0 var(--jdb-s-1);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
  }

  .jdb-author__name {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1vw, var(--jdb-fs-lg));
    font-weight: var(--jdb-fw-bold);
    letter-spacing: var(--jdb-track-heading);
    line-height: 1.15;
    color: var(--jdb-fg);
  }

  .jdb-author__bio {
    max-width: 60ch;
    margin: var(--pad) 0 0;
    font-size: var(--jdb-fs-base);
    color: var(--jdb-fg-dim);
  }

  .jdb-author__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--jdb-s-5);
    margin: var(--jdb-s-4) 0 0;
    padding: var(--jdb-s-2) 0 0;
    list-style: none;
    border-top: 1px solid var(--jdb-line);
  }

  .jdb-author__links li {
    margin: 0;
  }

  .jdb-author__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: var(--jdb-target);
    font-size: var(--jdb-fs-sm);
    font-weight: var(--jdb-fw-medium);
    color: var(--jdb-fg);
    text-decoration: none;
  }

  .jdb-author__links a:hover {
    color: var(--jdb-orange-400);
  }

  .jdb-author__ext {
    width: 0.8em;
    height: 0.8em;
  }
</style>
