---
/**
 * One client quote with the person's name, role, and photo (or initials).
 * Only use real quotes, with permission. See src/data/testimonials.ts.
 */
interface Props {
  quote: string;
  name: string;
  role?: string;
  /** Square photo path. Without one, initials are shown. */
  photo?: string;
  class?: string;
}

const { quote, name, role, photo, class: className } = Astro.props;
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part.replace(/[^\p{L}]/gu, '')[0]?.toUpperCase() ?? '')
  .join('');
---

<figure class:list={['jdb-quote', className]}>
  <svg class="jdb-quote__mark" viewBox="0 0 32 24" aria-hidden="true" focusable="false">
    <path d="M0 24V13.6C0 5.9 4.4 1.3 12 0l1.4 3.4C9 4.6 6.9 7.2 6.7 11H12v13H0Zm19 0V13.6C19 5.9 23.4 1.3 31 0l1 3.4c-4.4 1.2-6.5 3.8-6.7 7.6H31v13H19Z" />
  </svg>
  <blockquote class="jdb-quote__text">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="jdb-quote__by">
    {photo ? (
      <img class="jdb-quote__avatar" src={photo} alt="" width="44" height="44" loading="lazy" decoding="async" />
    ) : (
      <span class="jdb-quote__avatar jdb-quote__avatar--initials" aria-hidden="true">{initials}</span>
    )}
    <span>
      <span class="jdb-quote__name">{name}</span>
      {role && <span class="jdb-quote__role">{role}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .jdb-quote {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: var(--jdb-s-6);
  }

  .jdb-quote__mark {
    width: 2rem;
    height: 1.5rem;
    margin-bottom: var(--jdb-s-4);
    fill: var(--jdb-orange-500);
  }

  .jdb-quote__text {
    flex: 1;
    margin: 0;
  }

  .jdb-quote__text p {
    margin: 0;
    font-size: var(--jdb-fs-md);
    line-height: 1.5;
    color: var(--jdb-fg);
    text-wrap: pretty;
  }

  .jdb-quote__by {
    display: flex;
    align-items: center;
    gap: var(--jdb-s-3);
    margin-top: var(--jdb-s-6);
    padding-top: var(--jdb-s-4);
    border-top: 1px solid var(--jdb-line);
  }

  .jdb-quote__avatar {
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    filter: var(--jdb-photo-filter);
  }

  .jdb-quote__avatar--initials {
    display: grid;
    place-items: center;
    font-size: var(--jdb-fs-sm);
    font-weight: var(--jdb-fw-bold);
    color: var(--jdb-fg);
    background: var(--jdb-surface-overlay);
    filter: none;
  }

  .jdb-quote__name,
  .jdb-quote__role {
    display: block;
    line-height: 1.35;
  }

  .jdb-quote__name {
    font-size: var(--jdb-fs-sm);
    font-weight: var(--jdb-fw-semibold);
    color: var(--jdb-fg);
  }

  .jdb-quote__role {
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
  }
</style>
